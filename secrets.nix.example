{
  # SSH 公钥列表
  # 将你的 SSH 公钥添加到此列表
  user-public-ssh-keys = [
    # "ssh-ed25519 AAAA... your-email@example.com"
    # "ssh-rsa AAAA... your-email@example.com"
  ];

  # 用户名（对应 NixOS 用户名 & Home Manager）
  # username = "your-username";

  # 邮箱（Git 配置使用）
  # email = "your-email@example.com";

  # Xray VLESS+REALITY 出口配置
  # 将你的代理出站配置粘贴到下方数组中
  # xray-outbounds = [ ];
}
