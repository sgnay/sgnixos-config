// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1778549952646165599 @name=wechat
window-rule {
    match app-id="^wechat$"
    open-maximized-to-edges true
    open-on-workspace "chat"
}

// @id=wr_1785997583201357349 @name=Awesun
window-rule {
    match app-id="^Awesun$"
    open-maximized true
    open-maximized-to-edges true
    open-on-workspace "remote"
}

// @id=wr_1785997746278919130 @name=QQ
window-rule {
    match app-id="^QQ$"
    open-on-workspace "chat"
}

// @id=wr_1785997768631433309 @name=remote-viewer
window-rule {
    match app-id="^remote-viewer$"
    open-on-workspace "remote"
}
