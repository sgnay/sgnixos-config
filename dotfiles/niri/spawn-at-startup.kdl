// 启动niri时自动启动的软件
// spawn-at-startup "/usr/bin/dms" "run" // 通过 systemd 启动 dms 了
// spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "vicinae" "server"
spawn-at-startup "cursor-clip" "--daemon"
spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &"
spawn-sh-at-startup "~/.config/scripts/niri/niri-layout-modes.nu &" // 可以指定新的窗口，在上下左右四个方向打开
// 要运行shell命令（带有变量，管道等），请使用spawn-sh-at-at-startup：
// spawn-sh-at-startup "swaybg -i /path/to/your/wallpaper.png -m fill"
